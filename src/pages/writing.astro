---
import Prompt from "../components/Prompt.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const drafts = [
	"agent-first 自动化工具应该如何设计",
	"从目标到证据，重新理解端到端测试",
	"让 AI 真正操作 macOS 原生应用",
	"对话式 UI 验证的工程实践",
];
---

<BaseLayout
	title="writing — houlianpi"
	description="houlianpi 的项目记录、技术笔记和未完成的想法。"
>
	<p class="last-login">Last login: Tue Oct 13 on ttys002</p>

	<section class="terminal-block">
		<Prompt path="~/writing" command="find . -name '*.md' -not -path './.drafts/*'" />
		<p class="empty-output">find: no published files found</p>
	</section>

	<section class="terminal-block">
		<Prompt path="~/writing" branch="drafts" command="cat .drafts/index.txt" />
		<div class="markdown-output">
			<p><span class="comment"># 准备整理的主题</span></p>
			<p>旧文章没有迁移。这里会从零开始，记录项目、技术和还没有想清楚的问题。</p>
		</div>
		<ol class="draft-list">
			{drafts.map((draft, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{draft}</li>)}
		</ol>
	</section>
</BaseLayout>
