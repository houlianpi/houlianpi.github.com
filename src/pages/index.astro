---
import Prompt from "../components/Prompt.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";

const notes = [
	"agent-first-tooling.md",
	"evidence-driven-testing.md",
	"software-that-explains-failure.md",
	"macos-computer-use.md",
];
---

<BaseLayout
	title="houlianpi@localhost: ~"
	description="houlianpi 的个人终端：项目、开源贡献与技术笔记。"
>
	<p class="last-login">Last login: Tue Oct 13 17:37:02 on ttys000</p>

	<section class="terminal-block hero-command">
		<Prompt command="whoami" />
		<div class="whoami-output">
			<img src="https://avatars.githubusercontent.com/u/1460185?v=4" alt="houlianpi" width="96" height="96" />
			<div>
				<h1>芈峮 <span>/ houlianpi</span></h1>
				<p>quality engineering · automation · open source</p>
				<div class="quick-links">
					<a href="https://github.com/houlianpi" target="_blank" rel="noreferrer">github</a>
					<a href="/projects">projects</a>
					<a href="/about">about</a>
				</div>
			</div>
		</div>
	</section>

	<section class="terminal-block">
		<Prompt command="cat README.md" />
		<div class="markdown-output">
			<p>
				<span class="md-heading">#</span> 你好，我是芈峮。
			</p>
			<p>
				我是一名长期专注于软件质量与自动化的工程师，也是《iOS测试指南》的作者。
				从早期的移动端测试、持续集成，到今天的 AI Agent 与跨平台自动化，
				我一直在尝试把复杂、依赖经验的工作，变成可执行、可验证、可复用的工具和系统。
			</p>
			<p>
				现在，我参与 FSQ、AutoGenesis 等开源项目，也在构建 Maat。
				这些项目是我在 AI for UI Automation、Computer/Mobile Use 和 AI Evaluation
				方向上的一些尝试：让智能体能够理解界面、操作真实设备，并对执行结果作出可靠评估。
				这里记录项目背后的思考、工程实践，以及一路踩过的坑。
			</p>
		</div>
	</section>

	<section class="terminal-block">
		<Prompt path="~" branch="main" command="ls -lt projects/" />
		<div class="file-list" role="list">
			{
				projects.map((project) => (
					<a class="file-row" href={project.href} target="_blank" rel="noreferrer" role="listitem">
						<span class="permissions">drwxr-xr-x</span>
						<span class="file-owner">{project.owner}</span>
						<span class="file-date">{project.activity}</span>
						<strong>{project.name}/</strong>
						<span class="file-description">{project.description}</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="terminal-block">
		<Prompt path="~" command="gh activity --limit 6" />
		<div id="live-activity" class="live-activity">
			<p class="activity-loading">fetching public activity from github.com...</p>
		</div>
	</section>

	<section class="terminal-block">
		<Prompt path="~" command="find notes -maxdepth 1 -type f" />
		<ul class="terminal-files">
			{notes.map((note) => <li><a href="/writing">./notes/{note}</a></li>)}
		</ul>
	</section>
</BaseLayout>
